meta {
  name: Post User (Register)
  type: http
  seq: 2
}

post {
  url: http://localhost/users
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "password": "testpassword123"
  }
}

docs {
  Registra un nuevo usuario. Siempre se crea como "cliente":
  el campo "tipo" del body se ignora (los admins se crean vía seed
  con ADMIN_USERNAME/ADMIN_PASSWORD). Password: 8-72 caracteres.
}

settings {
  encodeUrl: true
}
