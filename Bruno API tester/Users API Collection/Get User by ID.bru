meta {
  name: Get User by ID
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/{{user_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

docs {
  Owner-or-admin: un usuario solo puede leer su propia cuenta; los admins,
  cualquiera. `id` es SIEMPRE string en la respuesta (la PK numérica es
  interna).

  - Otro usuario → 403 `forbidden`.
  - Inexistente → 404 `user_not_found`.
}

settings {
  encodeUrl: true
}
