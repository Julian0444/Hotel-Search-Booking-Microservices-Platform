meta {
  name: Search Hotels
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/search?q={{query}}&limit=20&offset=0
  body: none
  auth: none
}

vars:pre-request {
  query: palermo
}

assert {
  res.status: eq 200
}

docs {
  Full-text sobre name y description (Solr edismax; el input viaja como
  parámetro dereferenciado, nunca interpolado en la query). q vacío/ausente
  = todo el catálogo.

  Envelope de listas con `meta.total` = total REAL de matches en el índice.
  limit default 20, tope 100. Respuesta cacheada 5 min por el gateway
  (mirar `X-Cache-Status`).
}

settings {
  encodeUrl: true
}
