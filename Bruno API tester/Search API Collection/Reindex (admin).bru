meta {
  name: Reindex (admin)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/reindex
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

assert {
  res.status: eq 200
}

docs {
  Reconstruye el índice completo on-demand — SOLO admins (audiencia
  search-api + rol administrador; cliente → 403). Es el mismo backfill del
  arranque: pagina GET /hotels de hotels-api (fuente de verdad) y re-indexa
  todo en Solr. Sincrónico a propósito: el 200 con
  `{"data": {"indexed": N}}` confirma el índice reconstruido.

  Rescate manual para el caso raro de drift entre pipeline de eventos e
  índice.
}

settings {
  encodeUrl: true
}
