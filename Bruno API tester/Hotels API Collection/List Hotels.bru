meta {
  name: List Hotels
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/hotels?limit=20&offset=0
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200 && res.body.data.length > 0) {
    bru.setVar("hotel_id", res.body.data[0].id);
  }
}

assert {
  res.status: eq 200
}

docs {
  Catálogo público paginado, orden estable. Envelope de listas con
  `meta.total`. Es la fuente de verdad de la que deriva el índice de
  search-api (backfill/reindex).

  El post-response guarda el primer hotel para las requests públicas
  siguientes.
}

settings {
  encodeUrl: true
}
