meta {
  name: Get Hotel by ID
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/hotels/{{hotel_id}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  Detalle público de un hotel. Un id inexistente (o hex inválido) → 404
  `hotel_not_found`. `check_in_time`/`check_out_time` son horas del día
  "HH:mm"; `price_per_night` es el precio de catálogo en USD.
}

settings {
  encodeUrl: true
}
