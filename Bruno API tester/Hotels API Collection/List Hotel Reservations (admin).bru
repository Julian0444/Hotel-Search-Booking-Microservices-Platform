meta {
  name: List Hotel Reservations (admin)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/hotels/{{created_hotel_id}}/reservations?limit=20&offset=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

assert {
  res.status: eq 200
}

