meta {
  name: Delete Hotel (admin)
  type: http
  seq: 18
}

delete {
  url: {{baseUrl}}/admin/hotels/{{disposable_hotel_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

assert {
  res.status: eq 204
}

docs {
  Borra el hotel descartable SIN historial creado en esta corrida. Debe
  responder 204 y publicar DELETE; si el broker falla, mantiene éxito y
  la reconciliación elimina el documento huérfano de búsqueda.
  Un hotel con historial devuelve 409; el caso anterior lo comprueba.
}

settings {
  encodeUrl: true
}
