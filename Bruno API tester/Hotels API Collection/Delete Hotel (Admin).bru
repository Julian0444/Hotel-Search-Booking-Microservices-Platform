meta {
  name: Delete Hotel (admin)
  type: http
  seq: 16
}

delete {
  url: {{baseUrl}}/admin/hotels/{{created_hotel_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

assert {
  res.status: eq 204
}

docs {
  Borra el hotel creado en esta corrida (cleanup) — SOLO admins. 204 sin
  body; publica un evento DELETE en `hotels-news` y search-api lo saca del
  índice poco después. Las reservas existentes se conservan (historial
  auditable). Inexistente → 404 `hotel_not_found`.
}

settings {
  encodeUrl: true
}
