meta {
  name: Create Reservation (replay)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{guest_token}}
}

headers {
  Idempotency-Key: {{idem_key}}
}

body:json {
  {
    "hotel_id": "{{created_hotel_id}}",
    "check_in": "2027-03-01",
    "check_out": "2027-03-04",
    "num_rooms": 1,
    "num_guests": 2
  }
}

assert {
  res.status: eq 201
}

tests {
  test("es un replay idempotente (misma respuesta, sin reserva nueva)", function() {
    expect(res.headers["idempotency-replayed"]).to.equal("true");
    expect(res.body.data.id).to.equal(bru.getVar("reservation_id"));
  });
}

docs {
  MISMO body y MISMA `Idempotency-Key` que la request anterior: el servidor
  devuelve la respuesta guardada sin re-ejecutar (header
  `Idempotency-Replayed: true`, mismo id, una sola reserva en el historial).

  Si el original siguiera en vuelo → 409 `request_in_flight`; si hubiera
  terminado en 5xx, la key se libera para permitir el reintento real.
}

settings {
  encodeUrl: true
}
