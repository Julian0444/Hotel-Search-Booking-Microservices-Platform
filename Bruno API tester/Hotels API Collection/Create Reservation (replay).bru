meta {
  name: Create Reservation (replay)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{guest_token}}
}

headers {
  Idempotency-Key: {{idem_key}}
}

body:json {
  {
    "hotel_id": "{{created_hotel_id}}",
    "check_in": "2027-03-01",
    "check_out": "2027-03-04",
    "num_rooms": 1,
    "num_guests": 2
  }
}

assert {
  res.status: eq 201
}

tests {
  test("es un replay idempotente (misma respuesta, sin reserva nueva)", function() {
    expect(res.headers["idempotency-replayed"]).to.equal("true");
    expect(res.body.data.id).to.equal(bru.getVar("reservation_id"));
  });
}

docs {
  MISMO body y MISMA `Idempotency-Key` que la request anterior: el servidor
  devuelve la respuesta guardada sin re-ejecutar (header
  `Idempotency-Replayed: true`, mismo id, una sola reserva en el historial).

  La clave y su payload canónico se confirman junto con reserva e inventario.
  Un payload distinto devuelve 409 idempotency_conflict. Los concurrentes se
  coordinan en Mongo; no existe un registro separado permanentemente en vuelo.
  Ante timeout, reintentar con la MISMA key y body recupera el mismo ID si se
  confirmó. TTL 24h (limpieza asíncrona); no promete deduplicación indefinida.
}

settings {
  encodeUrl: true
}
