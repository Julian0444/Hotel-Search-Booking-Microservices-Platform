# Copy this file to `.env` and adjust the values:  cp .env.example .env
# These credentials are for LOCAL DEMO only — never commit a real .env.

# Databases / broker (local demo values)
MYSQL_ROOT_PASSWORD=change-me
MONGO_PASSWORD=change-me
RABBIT_PASSWORD=change-me

# Shared JWT signing secret (users-api issues, hotels-api verifies).
# Use a long random string; the services refuse to start with the code default.
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created at users-api startup (idempotent seed).
# This env seed is the ONLY source of admins; the SQL migrations only seed a
# demo client (demo / DemoCliente123 — see users-api/migrations/README.md).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
